+_SIDEBAR_SESSION_HEAVY_FIELDS = ("system_prompt", "model_config")
+
+
+def _strip_sidebar_session_rows(sessions: List[Dict[str, Any]]) -> None:
+    for session in sessions:
+        for key in _SIDEBAR_SESSION_HEAVY_FIELDS:
+            session.pop(key, None)
+
