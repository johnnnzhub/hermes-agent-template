{
  "name": "hermes-g2",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "build:smoke": "VITE_GLASS_DIAG=0 VITE_HERMES_API_BASE= npm run build",
    "build:prod": "VITE_GLASS_DIAG=0 VITE_HERMES_API_BASE=https://hermes-g2.tail390702.ts.net:8443 npm run build",
    "pack": "npm run build:prod && npm run check:bundle && evenhub pack app.json dist -o Hermes.ehpk",
    "build:diag": "VITE_GLASS_DIAG=1 VITE_HERMES_API_BASE=https://hermes-g2.tail390702.ts.net:8443 npm run build",
    "pack:diag": "npm run build:diag && evenhub pack app.json dist -o Hermes-diag.ehpk",
    "check:bundle": "node scripts/assert-clean-glass-bundle.mjs",
    "simulate": "evenhub-simulator http://localhost:5173",
    "mock-api": "node mock-hermes-api.mjs",
    "test": "node --test"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "^0.0.10"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "^0.1.12",
    "@evenrealities/evenhub-simulator": "^0.7.2",
    "typescript": "^5.7.0",
    "vite": "^5.4.0"
  }
}
