# Copy this file to `.env.local` and fill in. Never commit `.env.local`.

# 0.2.x — Hermes Glass API (token curto dedicado, escopo só /glass/*).
# O build:prod pina VITE_GLASS_API_BASE; o token vem daqui (baked no bundle —
# verificar pós-build com grep em dist/assets/*.js, regra da casa).
VITE_GLASS_API_TOKEN=

# Fase STT real (futura). Mock não precisa de nada.
VITE_STT_API_KEY=
